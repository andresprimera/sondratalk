# syntax=docker/dockerfile:1.4
#
# Build-time inputs are consumed via Dokploy "Build-time Secrets" (BuildKit secrets).
# Each secret name in Dokploy maps to a file at /run/secrets/<NAME> during the build.
# Required:
#   VITE_API_URL              public backend origin, e.g. https://api.example.com
# Optional:
#   VITE_SUPPORTED_LOCALES    e.g. en,es
#   VITE_LANDING_PAGE         "true" | "false"
FROM node:22-alpine AS builder

RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY shared ./shared
COPY frontend ./frontend

RUN --mount=type=secret,id=VITE_API_URL \
    --mount=type=secret,id=VITE_SUPPORTED_LOCALES \
    --mount=type=secret,id=VITE_LANDING_PAGE \
    export VITE_API_URL="$(cat /run/secrets/VITE_API_URL 2>/dev/null || true)" && \
    export VITE_SUPPORTED_LOCALES="$(cat /run/secrets/VITE_SUPPORTED_LOCALES 2>/dev/null || true)" && \
    export VITE_LANDING_PAGE="$(cat /run/secrets/VITE_LANDING_PAGE 2>/dev/null || true)" && \
    echo "==> Frontend build inputs:" && \
    echo "    VITE_API_URL=${VITE_API_URL:-<UNSET>}" && \
    echo "    VITE_SUPPORTED_LOCALES=${VITE_SUPPORTED_LOCALES:-<UNSET>}" && \
    echo "    VITE_LANDING_PAGE=${VITE_LANDING_PAGE:-<UNSET>}" && \
    if [ -z "$VITE_API_URL" ]; then \
      echo "ERROR: VITE_API_URL secret is empty. Set it in Dokploy → Environment → Build-time Secrets." >&2; \
      exit 1; \
    fi && \
    pnpm --filter frontend build

FROM nginx:alpine

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
