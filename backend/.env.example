MONGO_URI=mongodb://localhost:27017/base-dashboard
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Mail (SMTP / Nodemailer)
# Dev: run Mailpit locally — `docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit`
# Then set SMTP_HOST=localhost, SMTP_PORT=1025, leave SMTP_USER/SMTP_PASS empty.
# Inbox UI: http://localhost:8025
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="App Name <noreply@example.com>"

# Admin notification email — receives a notification when a user submits an onboarding application.
# Leave empty to disable notifications.
ADMIN_NOTIFICATION_EMAIL=

# Port the API listens on (defaults to 3030).
PORT=3030

# Frontend URL — base URL of the web app (no trailing slash).
# Used to build links in all outgoing emails: password reset, meeting join
# links, and scheduling notifications. Must point to the frontend domain,
# NOT the API domain. In production set this to e.g. https://app.example.com.
FRONTEND_URL=http://localhost:5174

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com).
# Leave unset for permissive CORS (development). In production, set to the
# deployed frontend origin(s) to restrict cross-origin requests.
CORS_ORIGIN=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
# GCS_BUCKET=my-bucket
# GCS_PROJECT_ID=my-project
# GCS_KEY_FILE=./gcs-key.json
# GCS_SIGNED_URL_EXPIRES=3600

# Firebase Storage (when STORAGE_PROVIDER=firebase)
# FIREBASE_BUCKET=my-bucket.appspot.com
# FIREBASE_KEY_FILE=./firebase-key.json
# FIREBASE_SIGNED_URL_EXPIRES=3600

# Seeding — set to "true" to run seeders (admin user, themes, circles) on boot.
# Off by default to avoid clobbering manual edits to seeded documents.
SEED_ON_BOOT=false

# Seed Admin (optional — creates default admin on first boot, only when SEED_ON_BOOT=true)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# AI / LLM (Agent Service)
AI_PROVIDER=openai
AI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...

# LiveKit (video calling — open-source SFU)
# Get an API key + secret + WSS URL from https://cloud.livekit.io (free tier).
# To self-host later, only LIVEKIT_URL changes.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud
